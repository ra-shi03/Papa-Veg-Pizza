Table AuditLog {
  id ObjectId [pk]
  userId ObjectId
  role String
  module String
  action String
  oldValue Object
  newValue Object
  ipAddress String
  device String
  createdAt Date
  updatedAt Date
}

Table Permission {
  id ObjectId [pk]
  module String
  action String
  description String
  createdAt Date
  updatedAt Date
}

Table RolePermission {
  id ObjectId [pk]
  roleId ObjectId
