{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@food/*": ["./src/modules/Food/*"],
      "@delivery/*": ["./src/modules/DeliveryV2/*"]
    }
  },
  "include": ["src"]
}
