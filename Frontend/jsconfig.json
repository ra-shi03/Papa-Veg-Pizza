{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"],
      "@food/*": ["./src/modules/Food/*"],
      "@delivery/*": ["./src/modules/DeliveryV2/*"]
    }
  },
  "include": ["src/**/*", "vite.config.js"],
  "exclude": ["node_modules", "dist", "build"]
}
